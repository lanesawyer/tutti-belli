# Turso database connection (drizzle; names kept from the Astro DB era)
# Set DATABASE_URL to a local libSQL URL to override (done automatically by pnpm dev/tests)
ASTRO_DB_REMOTE_URL=
ASTRO_DB_APP_TOKEN=

# JWT Secret for session tokens
JWT_SECRET=

# Email service
EMAIL_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Discord integration (optional)
# DISCORD_DISABLED=true  # Set to any value to skip Discord webhook posts (useful for tests)

# File storage (Tigris on Fly.io; `fly storage create` prints these)
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto
BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# STORAGE_DISABLED=true  # Set to any value to skip real uploads and deletes
