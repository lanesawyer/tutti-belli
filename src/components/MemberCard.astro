---
import { Card, Subtitle, Tag, Title } from "astro-bulma";
import Avatar from "@components/Avatar.astro";
import { isColor } from "@lib/bulma";

interface Group {
  name: string;
  color: string;
  description?: string | null;
}

interface Props {
  name: string;
  avatarUrl?: string | null;
  parts?: string[];
  groups?: Group[];
}

const { name, avatarUrl, parts, groups } = Astro.props;
---

<Card contentClass="has-text-centered">
  <Avatar name={name} avatarUrl={avatarUrl} size={96} class="mx-auto mb-3" />
  <Title as="p" size={6} class="mb-2">
    {name}
  </Title>
  {parts && parts.length > 0 && (
    <Subtitle as="p" class="is-7 has-text-grey mb-2">
      {parts.join(", ")}
    </Subtitle>
  )}
  {groups && groups.length > 0 && (
    <div class="tags are-small is-justify-content-center mt-2">
      {groups.map((group) => (
        <Tag
          color={isColor(group.color) ? group.color : undefined}
          title={group.description || group.name}
        >
          {group.name}
        </Tag>
      ))}
    </div>
  )}
</Card>
