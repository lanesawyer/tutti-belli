---
import { APP_NAME } from "@lib/config";
import { Button, Container, Tag, ThemeToggle } from "astro-bulma";
const user = Astro.locals.user;
---

<nav class="navbar is-dark" role="navigation" aria-label="main navigation">
  <Container>
    <div class="navbar-brand">
      <a class="navbar-item" href="/">
        <strong>🎵 {APP_NAME}</strong>
        <Tag color="warning" light class="ml-2">Alpha</Tag>
      </a>
      <a
        role="button"
        class="navbar-burger"
        aria-label="menu"
        aria-expanded="false"
        data-target="navbarMenu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </a>
    </div>

    <div id="navbarMenu" class="navbar-menu">
      <div class="navbar-start">
        {
          user && (
            <a class="navbar-item" href="/ensembles">
              My Ensembles
            </a>
          )
        }
        <slot name="navbar-start" />
      </div>

      <div class="navbar-end">
        {
          user?.role === "admin" && (
            <a class="navbar-item" href="/admin">
              Admin Panel
            </a>
          )
        }
        <ThemeToggle class="navbar-item theme-toggle" />
        {
          user ? (
            <div class="navbar-item has-dropdown is-hoverable">
              <a class="navbar-link">{user.name}</a>
              <div class="navbar-dropdown is-right">
                <a class="navbar-item" href="/profile">
                  Profile
                </a>
                <hr class="navbar-divider" />
                <a class="navbar-item" href="/logout">
                  Logout
                </a>
              </div>
            </div>
          ) : (
            <div class="navbar-item">
              <div class="buttons">
                <Button href="/register" color="primary">
                  <strong>Sign up</strong>
                </Button>
                <Button href="/login" color="light">
                  Log in
                </Button>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</nav>

<style>
  .navbar :global(.theme-toggle) {
    background: transparent;
    border: none;
    color: var(--navbar-text);
    font-size: 1.25rem;
    cursor: pointer;
  }

  .navbar :global(.theme-toggle:hover) {
    opacity: 0.8;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // Mobile menu toggle
    const $navbarBurgers = Array.prototype.slice.call(
      document.querySelectorAll(".navbar-burger"),
      0,
    );
    $navbarBurgers.forEach((el) => {
      el.addEventListener("click", () => {
        const target = el.dataset.target;
        const $target = document.getElementById(target);
        el.classList.toggle("is-active");
        $target?.classList.toggle("is-active");
      });
    });
  });
</script>
