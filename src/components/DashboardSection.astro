---
import { Box, Button, Icon, Level, Title } from "astro-bulma";

interface Props {
  title: string;
  icon?: string; // FA icon name e.g. "fa-bullhorn"
  viewAllHref?: string;
  viewAllLabel?: string;
  viewAllColor?: "primary" | "link" | "info" | "success" | "warning" | "danger";
  class?: string;
}

const {
  title,
  icon,
  viewAllHref,
  viewAllLabel = "View All",
  viewAllColor = "link",
  class: extraClass,
} = Astro.props;
---

<Box class={`mb-5 ${extraClass ?? ""}`}>
  <Level class="mb-4">
    <div class="level-item" slot="left">
      <Title as="h2" size={4}>
        {
          icon ? (
            <span class="icon-text">
              <Icon icon={icon} />
              <span>{title}</span>
            </span>
          ) : (
            title
          )
        }
      </Title>
    </div>
    {
      viewAllHref && (
        <div class="level-item" slot="right">
          <Button href={viewAllHref} size="small" color={viewAllColor}>
            {viewAllLabel}
          </Button>
        </div>
      )
    }
  </Level>

  <slot />
</Box>
