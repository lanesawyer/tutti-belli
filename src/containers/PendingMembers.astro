---
import { getPendingMembers } from "@lib/ensemble";
import { actions } from "astro:actions";
import { Box, Button, Content, Icon, Media, Title } from "astro-bulma";
import Avatar from "@components/Avatar.astro";

interface Props {
  ensembleId: string;
}

const { ensembleId } = Astro.props;

const pendingMembers = await getPendingMembers(ensembleId);

if (pendingMembers.length === 0) return;
---

<Box class="mb-5">
  <Title as="h2" size={5} class="mb-4">
    <span class="icon-text">
      <Icon icon="fa-user-clock" color="warning" />
      <span>Pending Members ({pendingMembers.length})</span>
    </span>
  </Title>
  <p class="mb-4 is-size-7">These members are awaiting approval to join the ensemble</p>

  <Content>
    {pendingMembers.map((member) => (
      <Box class="p-2 mb-2">
        <Media>
          <Fragment slot="left">
            <Avatar name={member.name} avatarUrl={member.avatarUrl} size={32} />
          </Fragment>
          <p class="is-size-7 has-text-weight-semibold pending-wrap">{member.name}</p>
          <p class="is-size-7 has-text-grey pending-wrap">{member.email}</p>
          <p class="is-size-7 has-text-grey-light">
            <small>Applied {new Date(member.joinedAt).toLocaleDateString()}</small>
          </p>
        </Media>
        <div class="pending-actions mt-2">
          <form method="POST" action={actions.members.approve} class="pending-action">
            <input type="hidden" name="membershipId" value={member.membershipId} />
            <input type="hidden" name="ensembleId" value={ensembleId} />
            <Button type="submit" color="success" size="small" fullwidth>
              <Icon icon="fa-check" />
              <span>Approve</span>
            </Button>
          </form>
          <form method="POST" action={actions.members.reject} class="pending-action">
            <input type="hidden" name="membershipId" value={member.membershipId} />
            <input type="hidden" name="ensembleId" value={ensembleId} />
            <Button type="submit" color="danger" size="small" fullwidth>
              <Icon icon="fa-times" />
              <span>Reject</span>
            </Button>
          </form>
        </div>
      </Box>
    ))}
  </Content>
</Box>

<style>
  .pending-wrap {
    overflow-wrap: anywhere;
  }
  .pending-actions {
    display: flex;
    gap: 0.5rem;
  }
  .pending-action {
    flex: 1;
    min-width: 0;
  }
</style>
