---
import { Button, Column, Columns, Delete, Select, TextInput, Textarea } from "astro-bulma";
import { actions } from "astro:actions";
import type { getEvent } from "@lib/events";
import type { getEnsembleGroups } from "@lib/groups";
import { instantToZonedInputs } from "@lib/timezone";

interface Props {
  ensembleId: string;
  event: NonNullable<Awaited<ReturnType<typeof getEvent>>>;
  groups: Awaited<ReturnType<typeof getEnsembleGroups>>;
  timeZone: string;
}

const { ensembleId, event, groups, timeZone } = Astro.props;

// Prepare date/time for form inputs
const { date: dateValue, time: timeValue } = instantToZonedInputs(
  new Date(event.scheduledAt),
  timeZone,
);
---

<div class="modal" id="edit-modal">
  <div class="modal-background" />
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title">Edit Event</p>
      <Delete label="close" id="close-edit-modal" />
    </header>
    <form method="POST" action={actions.events.edit}>
      <section class="modal-card-body">
        <input type="hidden" name="ensembleId" value={ensembleId} />
        <input type="hidden" name="eventId" value={event.id} />

        <TextInput name="title" id="edit-title" label="Title" value={event.title} required />

        <Textarea
          id="edit-description"
          name="description"
          label="Description"
          rows={3}
          value={event.description || ""}
        />

        <Columns>
          <Column size={4}>
            <TextInput
              name="date"
              id="edit-date"
              label="Date"
              type="date"
              value={dateValue}
              required
            />
          </Column>
          <Column size={4}>
            <TextInput
              name="time"
              id="edit-time"
              label="Time"
              type="time"
              value={timeValue}
              required
              help={timeZone.replaceAll("_", " ")}
            />
          </Column>
          <Column size={4}>
            <TextInput
              name="durationMinutes"
              id="edit-duration"
              label="Duration (min)"
              type="number"
              value={event.durationMinutes}
              min="15"
              max="480"
              required
            />
          </Column>
        </Columns>

        <TextInput
          name="location"
          id="edit-location"
          label="Location"
          value={event.location || ""}
        />

        {groups.length > 0 && (
          <Select
            id="edit-groupId"
            name="groupId"
            label="Group (optional)"
            fullwidth
            help="Restrict attendance tracking to this group's members."
          >
            <option value="">— All Members —</option>
            {groups.map((g) => (
              <option value={g.id} selected={event.groupId === g.id}>
                {g.name}
              </option>
            ))}
          </Select>
        )}

        <Select
          id="edit-rsvpEnabled"
          name="rsvpEnabled"
          label="RSVP"
          fullwidth
          help="Whether members can RSVP for this event."
        >
          <option value="" selected={event.rsvpEnabled === null}>
            Default (based on type)
          </option>
          <option value="1" selected={event.rsvpEnabled === 1}>
            Enabled
          </option>
          <option value="0" selected={event.rsvpEnabled === 0}>
            Disabled
          </option>
        </Select>
      </section>
      <footer class="modal-card-foot">
        <Button color="primary" type="submit">
          Save Changes
        </Button>
        <Button type="button" id="cancel-edit">
          Cancel
        </Button>
      </footer>
    </form>
  </div>
</div>
