---
import BaseLayout from "./BaseLayout.astro";
import { PageLayout } from "astro-bulma";

interface Props {
  title: string;
  pageTitle: string;
  pageSubtitle?: string;
  message?: string;
  messageType?: "link" | "primary" | "info" | "success" | "warning" | "danger";
}

const { title, ...pageProps } = Astro.props;
---

<BaseLayout title={title}>
  <slot name="navbar-start" slot="navbar-start" />

  <PageLayout {...pageProps}>
    <slot name="before" slot="before" />
    <slot name="action" slot="action" />
    <slot />
    <slot name="modals" slot="modals" />
  </PageLayout>
</BaseLayout>
