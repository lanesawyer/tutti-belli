---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SingleColumnLayout } from "astro-bulma";

interface Props {
  title: string;
  width?: "narrow" | "medium" | "wide";
}

const { title, width } = Astro.props;
---

<BaseLayout {title}>
  <SingleColumnLayout {width}>
    <slot />
  </SingleColumnLayout>
</BaseLayout>
