---
import SingleColumnLayout from "@layouts/SingleColumnLayout.astro";
import { Button, Notification } from "astro-bulma";
import { auth } from "@lib/auth";
import { getRedirectUrl } from "@lib/redirect";

const token = Astro.url.searchParams.get("token");
const callbackURL = Astro.url.searchParams.get("callbackURL") ?? "/ensembles";
let error = "";

if (!token) {
  error = "Invalid verification link.";
} else {
  try {
    const result = await auth.api.verifyEmail({
      query: { token, callbackURL },
      headers: Astro.request.headers,
      asResponse: true,
    });

    if (result.ok) {
      // Forward Set-Cookie if present then redirect
      const setCookie = result.headers.get("set-cookie");
      if (setCookie) {
        Astro.response.headers.append("Set-Cookie", setCookie);
      }
      // Better Auth may redirect; if not, do it ourselves
      const location = result.headers.get("location");
      return Astro.redirect(location ?? callbackURL);
    } else {
      error = "This verification link is invalid or has expired.";
    }
  } catch {
    error = "This verification link is invalid or has expired.";
  }
}
---

<SingleColumnLayout title="Verify Email">
  <h1 class="title">Email Verification</h1>

  {
    error && (
      <Notification color="danger" light>
        <p>{error}</p>
        <p class="mt-3">
          <Button href="/resend-verification" color="light">
            Resend verification email
          </Button>
        </p>
      </Notification>
    )
  }
</SingleColumnLayout>
