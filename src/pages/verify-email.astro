---
import { Button, Notification, Title } from "astro-bulma";
import SingleColumnLayout from "@layouts/SingleColumnLayout.astro";
import { verifyEmail } from "@lib/profile";
import { getRedirectUrl } from "@lib/redirect";

const token = Astro.url.searchParams.get("token");
const customRedirect = Astro.url.searchParams.get("redirect");
let error = "";
let verified = false;

if (!token) {
  error = "Invalid verification link.";
} else {
  const result = await verifyEmail(token, Astro.cookies);

  if (result.type === "invalid") {
    error = "This verification link is invalid or has expired.";
  } else if (result.type === "signedIn") {
    return Astro.redirect(await getRedirectUrl(result.userId, customRedirect));
  } else {
    verified = true;
  }
}

const loginUrl = customRedirect
  ? `/login?redirect=${encodeURIComponent(customRedirect)}`
  : "/login";
---

<SingleColumnLayout title="Verify Email">
  <Title>Email Verification</Title>

  {verified && (
    <Notification color="success" light>
      <p>Your email is verified. Log in to continue.</p>
      <p class="mt-3">
        <Button href={loginUrl} color="primary">
          Log In
        </Button>
      </p>
    </Notification>
  )}

  {error && (
    <Notification color="danger" light>
      <p>{error}</p>
      <p class="mt-3">
        <Button href="/resend-verification" color="light">
          Resend verification email
        </Button>
      </p>
    </Notification>
  )}
</SingleColumnLayout>
