---
import SingleColumnLayout from "@layouts/SingleColumnLayout.astro";
import { Button, Notification, TextInput, Title } from "astro-bulma";
import { actions } from "astro:actions";

const prefillEmail = Astro.url.searchParams.get("email") ?? "";
const result = Astro.getActionResult(actions.auth.resendVerification);
const sent = !!result && !result.error;
---

<SingleColumnLayout title="Resend Verification Email">
  <Title>Resend Verification Email</Title>

  {sent ? (
    <Notification color="success" light>
      <p>
        If an unverified account exists for that email, we've sent a new verification link. Please
        check your inbox.
      </p>
      <p class="mt-3">
        <Button href="/login" color="primary">
          Back to Login
        </Button>
      </p>
    </Notification>
  ) : (
    <>
      <p class="mb-4">Enter your email address and we'll resend the verification link.</p>

      <form method="POST" action={actions.auth.resendVerification}>
        <TextInput
          name="email"
          label="Email"
          type="email"
          placeholder="you@example.com"
          value={prefillEmail}
          iconLeft="fa-envelope"
          required
        />

        <div class="field">
          <div class="control">
            <Button color="primary" fullwidth type="submit">
              Resend Verification Email
            </Button>
          </div>
        </div>
      </form>

      <div class="has-text-centered mt-4">
        <p>
          <a href="/login">Back to login</a>
        </p>
      </div>
    </>
  )}
</SingleColumnLayout>
