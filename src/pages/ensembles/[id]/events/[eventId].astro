---
import {
  Box,
  Button,
  Column,
  Columns,
  Content,
  Icon,
  Level,
  Notification,
  Subtitle,
  Tag,
  Title,
} from "astro-bulma";
import BaseLayout from "@layouts/BaseLayout.astro";
import { actions } from "astro:actions";
import QRCode from "qrcode";
import { ensembleAdminTools } from "@lib/config";
import { loadEnsemblePage } from "@lib/ensemble";
import { siteLink } from "@lib/site-url";
import {
  getEvent,
  getEventProgramData,
  getEventPageData,
  isRsvpEnabled,
  getRsvpForUser,
} from "@lib/events";
import { getEnsembleGroups } from "@lib/groups";
import { formatDuration } from "@lib/format";
import { formatZonedDate, formatZonedTime } from "@lib/timezone";
import Rsvp from "@containers/event/Rsvp.astro";
import CheckIn from "@containers/event/CheckIn.astro";
import Attendance from "@containers/event/Attendance.astro";
import Program from "@containers/event/Program.astro";
import EditEventModal from "@containers/event/EditEventModal.astro";
import EditEntryModal from "@containers/event/EditEntryModal.astro";

const user = Astro.locals.user!;

const page = await loadEnsemblePage(user, {
  id: Astro.params.id,
  method: Astro.request.method,
  pathname: Astro.url.pathname,
});
if (page.response) return page.response;
const { ensemble, canonicalId, isAdmin } = page;

const event = await getEvent(ensemble.id, Astro.params.eventId!);
if (!event) {
  return Astro.redirect(`/ensembles/${canonicalId}/events`);
}

// Calculate check-in window
const now = new Date();
const scheduledTime = new Date(event.scheduledAt);
const checkInStartTime = new Date(
  scheduledTime.getTime() - ensemble.checkInStartMinutes * 60 * 1000,
);
const checkInEndTime = new Date(scheduledTime.getTime() + ensemble.checkInEndMinutes * 60 * 1000);

const canCheckIn = now >= checkInStartTime && now <= checkInEndTime;
const isTooEarly = now < checkInStartTime;
const isTooLate = now > checkInEndTime;

const editResult = Astro.getActionResult(actions.events.edit);

const checkInResult = Astro.getActionResult(actions.events.checkIn);
const addAttendanceResult = Astro.getActionResult(actions.events.addAttendance);
const removeAttendanceResult = Astro.getActionResult(actions.events.removeAttendance);
const updateNotesResult = Astro.getActionResult(actions.events.updateProgramSongNotes);
const rsvpResult = Astro.getActionResult(actions.events.rsvp);
const removeRsvpResult = Astro.getActionResult(actions.events.removeRsvp);

let message = "";
if (checkInResult?.error) message = checkInResult.error.message || "Check-in failed.";
else if (checkInResult) message = "Successfully checked in!";
else if (addAttendanceResult && !addAttendanceResult.error) message = "Member marked as present.";
else if (removeAttendanceResult && !removeAttendanceResult.error) message = "Attendance removed.";
else if (editResult && !editResult.error) message = "Event updated successfully!";
else if (editResult?.error) message = editResult.error.message || "Failed to update event.";
else if (updateNotesResult && !updateNotesResult.error) message = "Notes updated.";
else if (updateNotesResult?.error)
  message = updateNotesResult.error.message || "Failed to update notes.";
else if (rsvpResult && !rsvpResult.error) message = "RSVP saved!";
else if (rsvpResult?.error) message = rsvpResult.error.message || "Failed to save RSVP.";
else if (removeRsvpResult && !removeRsvpResult.error) message = "RSVP removed.";
else if (removeRsvpResult?.error)
  message = removeRsvpResult.error.message || "Failed to remove RSVP.";

const rsvpOn = isRsvpEnabled(event);
const checkInUrl = siteLink(`/checkin/${encodeURIComponent(event.checkInCode)}`);

const [
  // Attendance records, RSVP records, member list (scoped to group if set), and group metadata
  { attendanceRecords, rsvpRecords, allMembers, group },
  userRsvp,
  // Groups for the edit modal selector
  groups,
  // Program data for all event types (rehearsal + performance)
  { programEntries, availableSeasonSongs },
  // Only admins see the check-in QR code
  qrCodeDataUrl,
] = await Promise.all([
  getEventPageData(ensemble.id, event),
  rsvpOn ? getRsvpForUser(event.id, user.id) : null,
  getEnsembleGroups(ensemble.id),
  getEventProgramData(event.id, event.seasonId),
  isAdmin ? QRCode.toDataURL(checkInUrl, { width: 300, margin: 2 }) : "",
]);

const attendedUserIds = new Set(attendanceRecords.map((a) => a.userId));
const scheduledDate = new Date(event.scheduledAt);
const endTime = new Date(scheduledDate.getTime() + event.durationMinutes * 60 * 1000);
const isPast = endTime < new Date();
const isUserCheckedIn = attendedUserIds.has(user.id);

const isPerformance = event.category === "performance";
const isSocial = event.category === "social";
const isSectional = event.category === "sectional";
const categoryLabel = isPerformance
  ? "Performance"
  : isSocial
    ? "Social"
    : isSectional
      ? "Sectional"
      : "Rehearsal";
const categoryColor = isPerformance
  ? "warning"
  : isSocial
    ? "success"
    : isSectional
      ? "info"
      : "primary";
const programLabel = isPerformance ? "Set List" : "Rehearsal Plan";
---

<BaseLayout title={`${event.title} - ${ensemble.name}`}>
  {isAdmin && (
    <div class="navbar-item has-dropdown is-hoverable" slot="navbar-start">
      <a class="navbar-link">{ensemble.name}</a>
      <div class="navbar-dropdown">
        <a
          class={`navbar-item${Astro.url.pathname === `/ensembles/${canonicalId}` ? " is-active" : ""}`}
          href={`/ensembles/${canonicalId}`}
        >
          <Icon icon="fa-home" size="small" class="mr-1" />
          Dashboard
        </a>
        <hr class="navbar-divider" />
        {ensembleAdminTools.map((tool) => {
          const href = tool.href(canonicalId);
          return (
            <a
              class={`navbar-item${Astro.url.pathname.startsWith(href) ? " is-active" : ""}`}
              href={href}
            >
              <Icon icon={tool.icon} size="small" class="mr-1" />
              {tool.label}
            </a>
          );
        })}
      </div>
    </div>
  )}

  <Level class="mb-5">
    <Fragment slot="left">
      <div class="level-item">
        <div>
          <Title>
            {event.title}
            <Tag color={categoryColor} class="ml-2">
              {categoryLabel}
            </Tag>
            {group && (
              <Tag color={group.color as any} class="ml-2">
                {group.name}
              </Tag>
            )}
          </Title>
          <Subtitle as="p">
            <span class="icon-text">
              <Icon icon="fa-calendar" />
              <span>{formatZonedDate(scheduledDate, ensemble.timezone)}</span>
            </span>
            <span class="ml-3 icon-text">
              <Icon icon="fa-clock" />
              <span>{formatZonedTime(scheduledDate, ensemble.timezone)}</span>
            </span>
            <span class="ml-3 icon-text">
              <Icon icon="fa-hourglass-half" />
              <span>{formatDuration(event.durationMinutes)}</span>
            </span>
            {event.location && (
              <span class="ml-3 icon-text">
                <Icon icon="fa-map-marker-alt" />
                <span>{event.location}</span>
              </span>
            )}
          </Subtitle>
        </div>
      </div>
    </Fragment>
    <Fragment slot="right">
      <div class="level-item">
        <div class="buttons">
          {isAdmin && (
            <Button color="warning" id="edit-event-btn">
              <Icon icon="fa-edit" />
              <span>Edit Event</span>
            </Button>
          )}
          <Button href={`/ensembles/${canonicalId}/events`}>
            <Icon icon="fa-arrow-left" />
            <span>Back to Events</span>
          </Button>
        </div>
      </div>
    </Fragment>
  </Level>

  {message && (
    <Notification color="success" light>
      {message}
    </Notification>
  )}

  {event.description && (
    <Box>
      <Content>{event.description}</Content>
    </Box>
  )}

  <Columns>
    <Column>
      {rsvpOn && !isAdmin && (
        <Rsvp ensembleId={ensemble.id} eventId={event.id} userRsvp={userRsvp} />
      )}

      <CheckIn
        ensembleId={ensemble.id}
        eventId={event.id}
        isAdmin={isAdmin}
        isPast={isPast}
        isUserCheckedIn={isUserCheckedIn}
        canCheckIn={canCheckIn}
        isTooEarly={isTooEarly}
        isTooLate={isTooLate}
        checkInStartMinutes={ensemble.checkInStartMinutes}
        checkInEndMinutes={ensemble.checkInEndMinutes}
        checkInUrl={checkInUrl}
        qrCodeDataUrl={qrCodeDataUrl}
      />
    </Column>

    {isAdmin && (
      <Column>
        <Attendance
          ensembleId={ensemble.id}
          eventId={event.id}
          timeZone={ensemble.timezone}
          rsvpOn={rsvpOn}
          group={group}
          allMembers={allMembers}
          attendanceRecords={attendanceRecords}
          rsvpRecords={rsvpRecords}
        />
      </Column>
    )}
  </Columns>

  <Program
    ensembleId={ensemble.id}
    canonicalId={canonicalId}
    eventId={event.id}
    isAdmin={isAdmin}
    isPerformance={isPerformance}
    programLabel={programLabel}
    iconColor={categoryColor}
    scheduledAt={scheduledDate}
    durationMinutes={event.durationMinutes}
    timeZone={ensemble.timezone}
    programEntries={programEntries}
    availableSeasonSongs={availableSeasonSongs}
  />

  <!-- Edit Event Modal -->
  {isAdmin && (
    <EditEventModal
      ensembleId={ensemble.id}
      event={event}
      groups={groups}
      timeZone={ensemble.timezone}
    />
  )}

  <!-- Edit Entry Modal -->
  {isAdmin && <EditEntryModal ensembleId={ensemble.id} isPerformance={isPerformance} />}

  <script>
    document.addEventListener("astro:page-load", () => {
      const editModal = document.getElementById("edit-modal");
      const editBtn = document.getElementById("edit-event-btn");
      const closeEditModal = document.getElementById("close-edit-modal");
      const cancelEdit = document.getElementById("cancel-edit");

      const checkInUrl = document.querySelector<HTMLInputElement>('input[name="checkInUrl"]');
      checkInUrl?.addEventListener("click", () => checkInUrl.select());

      const openEditModal = () => editModal?.classList.add("is-active");
      const closeModal = () => editModal?.classList.remove("is-active");

      editBtn?.addEventListener("click", openEditModal);
      closeEditModal?.addEventListener("click", closeModal);
      cancelEdit?.addEventListener("click", closeModal);
      editModal?.querySelector(".modal-background")?.addEventListener("click", closeModal);

      // Edit entry modal
      const entryModal = document.getElementById("edit-entry-modal");
      if (entryModal) {
        const entryIdInput = document.getElementById("edit-entry-id") as HTMLInputElement | null;
        const labelField = document.getElementById("edit-entry-label-field");
        const labelInput = document.getElementById("edit-entry-label") as HTMLInputElement | null;
        const sortOrderInput = document.getElementById(
          "edit-entry-sort-order",
        ) as HTMLInputElement | null;
        const lengthInput = document.getElementById(
          "edit-entry-practice-minutes",
        ) as HTMLInputElement | null;
        const notesTextarea = document.getElementById(
          "edit-entry-notes",
        ) as HTMLTextAreaElement | null;

        const closeEntryModal = () => entryModal.classList.remove("is-active");

        document.querySelectorAll(".edit-entry-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const el = btn as HTMLElement;
            const isSong = el.dataset.type === "song";
            if (entryIdInput) entryIdInput.value = el.dataset.entryId ?? "";
            if (labelField) labelField.style.display = isSong ? "none" : "";
            if (labelInput) labelInput.value = el.dataset.label ?? "";
            if (sortOrderInput) sortOrderInput.value = el.dataset.sortOrder ?? "";
            if (lengthInput) lengthInput.value = el.dataset.practiceMinutes ?? "";
            if (notesTextarea) notesTextarea.value = el.dataset.notes ?? "";
            entryModal.classList.add("is-active");
          });
        });

        entryModal.querySelector(".modal-background")?.addEventListener("click", closeEntryModal);
        entryModal.querySelectorAll("[data-close-entry-modal]").forEach((btn) => {
          btn.addEventListener("click", closeEntryModal);
        });
      }
    });
  </script>
</BaseLayout>
