---
import {
  Box,
  Breadcrumb,
  Button,
  Container,
  Icon,
  Level,
  Progress,
  Section,
  Subtitle,
  Table,
  Title,
} from "astro-bulma";
import BaseLayout from "@layouts/BaseLayout.astro";
import { ensembleAdminTools } from "@lib/config";
import Avatar from "@components/Avatar.astro";
import { loadEnsemblePage } from "@lib/ensemble";
import { getMemberAttendanceStats } from "@lib/member-attendance";
import { getEnsembleSeasons } from "@lib/seasons";

const user = Astro.locals.user!;

const page = await loadEnsemblePage(
  user,
  { id: Astro.params.id, method: Astro.request.method, pathname: Astro.url.pathname },
  { adminOnly: true },
);
if (page.response) return page.response;
const { ensemble, canonicalId } = page;

const seasonId = Astro.url.searchParams.get("seasonId") ?? undefined;
const [seasons, stats] = await Promise.all([
  getEnsembleSeasons(ensemble.id),
  getMemberAttendanceStats(ensemble.id, seasonId),
]);

const selectedSeason = seasons.find((s) => s.id === seasonId);
---

<BaseLayout title={`Member Attendance - ${ensemble.name}`}>
  <div class="navbar-item has-dropdown is-hoverable" slot="navbar-start">
    <a class="navbar-link">{ensemble.name}</a>
    <div class="navbar-dropdown">
      <a
        class={`navbar-item${Astro.url.pathname === `/ensembles/${canonicalId}` ? " is-active" : ""}`}
        href={`/ensembles/${canonicalId}`}
      >
        <Icon icon="fa-home" size="small" class="mr-1" />
        Dashboard
      </a>
      <hr class="navbar-divider" />
      {ensembleAdminTools.map((tool) => {
        const href = tool.href(canonicalId);
        return (
          <a
            class={`navbar-item${Astro.url.pathname.startsWith(href) ? " is-active" : ""}`}
            href={href}
          >
            <Icon icon={tool.icon} size="small" class="mr-1" />
            {tool.label}
          </a>
        );
      })}
    </div>
  </div>

  <Section>
    <Container>
      <Breadcrumb
        items={[
          { label: ensemble.name, href: `/ensembles/${canonicalId}` },
          { label: "Members", href: `/ensembles/${canonicalId}/members` },
          { label: "Attendance" },
        ]}
      />

      <Level class="mb-5">
        <Fragment slot="left">
          <div class="level-item">
            <div>
              <Title>Member Attendance</Title>
              <Subtitle as="p">
                {selectedSeason ? `Season: ${selectedSeason.name}` : "All time"}
              </Subtitle>
            </div>
          </div>
        </Fragment>
        <Fragment slot="right">
          {seasons.length > 0 && (
            <div class="level-item">
              <div class="field has-addons">
                <div class="control">
                  <div class="select">
                    <select id="season-filter">
                      <option value="">All seasons</option>
                      {seasons.map((s) => (
                        <option value={s.id} selected={s.id === seasonId}>
                          {s.name}
                          {s.isActive ? " (active)" : ""}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>
              </div>
            </div>
          )}
          <div class="level-item">
            <Button
              href={`/ensembles/${canonicalId}/export/attendance${seasonId ? `?seasonId=${seasonId}` : ""}`}
            >
              <Icon icon="fa-download" />
              <span>Export CSV</span>
            </Button>
          </div>
        </Fragment>
      </Level>

      <Box>
        {stats.length === 0 ? (
          <p class="has-text-grey">No active members found.</p>
        ) : (
          <Table className="is-vcentered">
            <thead>
              <tr>
                <th style="width: 60px;" />
                <th>Name</th>
                <th>Role</th>
                <th>Attended</th>
                <th>Total Events</th>
                <th>Attendance %</th>
              </tr>
            </thead>
            <tbody>
              {stats.map((member) => (
                <tr>
                  <td>
                    <Avatar name={member.name} avatarUrl={member.avatarUrl} size={48} />
                  </td>
                  <td>
                    <div>{member.name}</div>
                    <div class="is-size-7 has-text-grey">{member.email}</div>
                  </td>
                  <td>
                    <span class={`tag ${member.role === "admin" ? "is-warning" : "is-info"}`}>
                      {member.role === "admin" ? "Admin" : "Member"}
                    </span>
                  </td>
                  <td>{member.attended}</td>
                  <td>{member.total}</td>
                  <td>
                    <div class="is-flex is-align-items-center" style="gap: 0.5rem;">
                      <Progress
                        size="small"
                        color={
                          member.pct >= 75 ? "success" : member.pct >= 50 ? "warning" : "danger"
                        }
                        class="mb-0"
                        value={member.pct}
                        max={100}
                        style="width: 80px;"
                      />
                      <span
                        class={`has-text-weight-semibold ${member.pct >= 75 ? "has-text-success" : member.pct >= 50 ? "has-text-warning" : "has-text-danger"}`}
                      >
                        {member.pct}%
                      </span>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        )}
      </Box>
    </Container>
  </Section>
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const filter = document.getElementById("season-filter") as HTMLSelectElement | null;
    filter?.addEventListener("change", () => {
      window.location.href = filter.value ? `?seasonId=${filter.value}` : "?";
    });
  });
</script>
