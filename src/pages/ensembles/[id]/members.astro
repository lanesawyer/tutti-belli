---
import {
  Box,
  Breadcrumb,
  Button,
  Container,
  Icon,
  Image,
  Level,
  Modal,
  Notification,
  Section,
  Select,
  Subtitle,
  Table,
  TextInput,
  Title,
} from "astro-bulma";
import BaseLayout from "@layouts/BaseLayout.astro";
import { actions } from "astro:actions";
import { ensembleAdminTools } from "@lib/config";
import { getInitials, getColorFromInitials } from "@lib/avatar";
import {
  getEnsembleBySlugOrId,
  getEnsembleAccess,
  getEnsembleMembersWithUsers,
  getEnsembleParts,
  getMemberPartAssignments,
} from "@lib/ensemble";
import { getEnsembleUrlId } from "@lib/slug";
import { getSiteAdminIds } from "@lib/admin";
import { isSiteAdmin } from "@lib/permissions";

const user = Astro.locals.user!;

const { id } = Astro.params;
const ensemble = await getEnsembleBySlugOrId(id!);
if (!ensemble) {
  return Astro.redirect("/ensembles");
}

const canonicalId = getEnsembleUrlId(ensemble);
if (Astro.request.method === "GET" && id !== canonicalId) {
  return Astro.redirect(
    Astro.url.pathname.replace(`/ensembles/${id}`, `/ensembles/${canonicalId}`),
    301,
  );
}

const access = await getEnsembleAccess(user, ensemble.id);
if (!access) return Astro.redirect("/ensembles");
const { isAdmin } = access;

if (!isAdmin) {
  return new Response("Unauthorized", { status: 403 });
}

// Site admins can view the site as any member who isn't also a site admin.
const viewAsBlocked = isSiteAdmin(user) ? await getSiteAdminIds() : null;

const canAddMembers = isSiteAdmin(user);
const addResult = Astro.getActionResult(actions.members.add);

const removeResult = Astro.getActionResult(actions.members.remove);
const promoteResult = Astro.getActionResult(actions.members.promote);
const demoteResult = Astro.getActionResult(actions.members.demote);

if (
  (removeResult || promoteResult || demoteResult) &&
  !removeResult?.error &&
  !promoteResult?.error &&
  !demoteResult?.error
) {
  return Astro.redirect(`/ensembles/${canonicalId}/members`);
}

const membersData = await getEnsembleMembersWithUsers(ensemble.id);
const allParts = await getEnsembleParts(ensemble.id);
const membershipIds = membersData.map((m) => m.membershipId);
const memberPartRows = await getMemberPartAssignments(membershipIds);

const membersByPart = new Map<string, typeof membersData>();
const membersWithPartIds = new Set<string>();

for (const mp of memberPartRows) {
  const member = membersData.find((m) => m.membershipId === mp.membershipId);
  if (!member) continue;
  membersWithPartIds.add(mp.membershipId);
  if (!membersByPart.has(mp.partId)) {
    membersByPart.set(mp.partId, []);
  }
  membersByPart.get(mp.partId)!.push(member);
}

const membersWithoutPart = membersData.filter(
  (m) => !membersWithPartIds.has(m.membershipId),
);

const members = membersData;
---

<BaseLayout title={`Manage Members - ${ensemble.name}`}>
  <div class="navbar-item has-dropdown is-hoverable" slot="navbar-start">
    <a class="navbar-link">{ensemble.name}</a>
    <div class="navbar-dropdown">
      <a
        class={`navbar-item${Astro.url.pathname === `/ensembles/${canonicalId}` ? " is-active" : ""}`}
        href={`/ensembles/${canonicalId}`}
      >
        <Icon icon="fa-home" size="small" class="mr-1" />
        Dashboard
      </a>
      <hr class="navbar-divider" />
      {
        ensembleAdminTools.map((tool) => {
          const href = tool.href(canonicalId);
          return (
            <a
              class={`navbar-item${Astro.url.pathname.startsWith(href) ? " is-active" : ""}`}
              href={href}
            >
              <Icon icon={tool.icon} size="small" class="mr-1" />
              {tool.label}
            </a>
          );
        })
      }
    </div>
  </div>
  <Section>
    <Container>
      <Breadcrumb
        items={[
          { label: "Ensembles", href: "/ensembles" },
          { label: ensemble.name, href: `/ensembles/${canonicalId}` },
          { label: "Manage Members" },
        ]}
      />

      <Level class="mb-5">
        <Fragment slot="left">
          <div class="level-item">
            <div>
              <Title>Manage Members</Title>
              <Subtitle as="p">Total Members: {members.length}</Subtitle>
            </div>
          </div>
        </Fragment>
        <Fragment slot="right">
          {
            canAddMembers && (
              <div class="level-item">
                <Button color="primary" id="add-member-btn">
                  <Icon icon="fa-user-plus" />
                  <span>Add Member</span>
                </Button>
              </div>
            )
          }
          <div class="level-item">
            <Button href={`/ensembles/${canonicalId}/member-attendance`}>
              <Icon icon="fa-chart-bar" />
              <span>Attendance</span>
            </Button>
          </div>
          <div class="level-item">
            <Button href={`/ensembles/${canonicalId}/export/members`}>
              <Icon icon="fa-download" />
              <span>Export CSV</span>
            </Button>
          </div>
          <div class="level-item">
            <Button href={`/ensembles/${canonicalId}`}>
              <Icon icon="fa-arrow-left" />
              <span>Back to Ensemble</span>
            </Button>
          </div>
        </Fragment>
      </Level>

      {
        addResult?.error && (
          <Notification color="danger" light>
            {addResult.error.message || "Couldn't add that member."}
          </Notification>
        )
      }
      {
        addResult?.data && (
          <Notification color="success" light>
            <p>
              Added <strong>{addResult.data.name}</strong> to {ensemble.name}.{" "}
              {addResult.data.emailSent
                ? "We emailed them to let them know."
                : "The email to them couldn't be sent, so they haven't been told."}
            </p>
            {addResult.data.setPasswordUrl && (
              <div class="mt-3">
                <p class="mb-2">
                  They're new, so they need to set a password.
                  {addResult.data.emailSent
                    ? " The email has this link; you can also send it yourself."
                    : " Send them this link"}{" "}
                  (valid for 7 days):
                </p>
                <div class="field has-addons">
                  <div class="control is-expanded">
                    <input
                      id="set-password-url"
                      class="input is-small"
                      readonly
                      value={addResult.data.setPasswordUrl}
                    />
                  </div>
                  <div class="control">
                    <button
                      type="button"
                      class="button is-small"
                      id="copy-set-password-url"
                    >
                      Copy
                    </button>
                  </div>
                </div>
              </div>
            )}
          </Notification>
        )
      }

      <Box>
        {
          allParts.length > 0 ? (
            <>
              {allParts.map((part) => {
                const partMembers = membersByPart.get(part.id) || [];
                if (partMembers.length === 0) return null;

                return (
                  <div class="mb-5">
                    <Table
                      title={`${part.name} (${partMembers.length})`}
                      className="has-text-primary"
                    >
                      <thead>
                        <tr>
                          <th style="width: 60px;" />
                          <th>Name</th>
                          <th>Email</th>
                          <th>Role</th>
                          <th>Joined</th>
                          <th>Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        {partMembers.map((member: any) => (
                          <tr>
                            <td>
                              {member.avatarUrl ? (
                                <Image
                                  src={member.avatarUrl}
                                  alt={member.name}
                                  size="48x48"
                                  rounded
                                  imgStyle="object-fit: cover;"
                                />
                              ) : (
                                <figure class="image is-48x48">
                                  <div
                                    style={`width: 48px; height: 48px; border-radius: 50%; background-color: ${getColorFromInitials(getInitials(member.name))}; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.25rem; font-weight: bold;`}
                                  >
                                    {getInitials(member.name)}
                                  </div>
                                </figure>
                              )}
                            </td>
                            <td>{member.name}</td>
                            <td>{member.email}</td>
                            <td>
                              <span
                                class={`tag ${member.role === "admin" ? "is-warning" : "is-info"}`}
                              >
                                {member.role === "admin" ? "Admin" : "Member"}
                              </span>
                            </td>
                            <td>
                              {new Date(member.joinedAt).toLocaleDateString()}
                            </td>
                            {member.id !== user.id && (
                              <td>
                                <div class="buttons are-small">
                                  {viewAsBlocked && !viewAsBlocked.has(member.id) && (
                                    <form method="POST" action="/view-as" style="display: inline;">
                                      <input type="hidden" name="userId" value={member.id} />
                                      <input type="hidden" name="returnTo" value={`/ensembles/${canonicalId}`} />
                                      <Button type="submit" color="link" size="small">
                                        View as
                                      </Button>
                                    </form>
                                  )}
                                  {member.role === "member" ? (
                                    <form
                                      method="POST"
                                      action={actions.members.promote}
                                      style="display: inline;"
                                    >
                                      <input
                                        type="hidden"
                                        name="ensembleId"
                                        value={ensemble.id}
                                      />
                                      <input
                                        type="hidden"
                                        name="membershipId"
                                        value={member.membershipId}
                                      />
                                      <Button
                                        type="submit"
                                        color="warning"
                                        size="small"
                                      >
                                        Make Admin
                                      </Button>
                                    </form>
                                  ) : (
                                    <form
                                      method="POST"
                                      action={actions.members.demote}
                                      style="display: inline;"
                                    >
                                      <input
                                        type="hidden"
                                        name="ensembleId"
                                        value={ensemble.id}
                                      />
                                      <input
                                        type="hidden"
                                        name="membershipId"
                                        value={member.membershipId}
                                      />
                                      <Button
                                        type="submit"
                                        color="info"
                                        size="small"
                                      >
                                        Remove Admin
                                      </Button>
                                    </form>
                                  )}
                                  <form
                                    method="POST"
                                    action={actions.members.remove}
                                    style="display: inline;"
                                  >
                                    <input
                                      type="hidden"
                                      name="ensembleId"
                                      value={ensemble.id}
                                    />
                                    <input
                                      type="hidden"
                                      name="membershipId"
                                      value={member.membershipId}
                                    />
                                    <Button
                                      type="submit"
                                      color="danger"
                                      size="small"
                                    >
                                      Remove
                                    </Button>
                                  </form>
                                </div>
                              </td>
                            )}
                          </tr>
                        ))}
                      </tbody>
                    </Table>
                  </div>
                );
              })}

              {membersWithoutPart.length > 0 && (
                <div class="mb-5">
                  <Table
                    title={`No Part Assigned (${membersWithoutPart.length})`}
                  >
                    <thead>
                      <tr>
                        <th style="width: 60px;" />
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {membersWithoutPart.map((member) => (
                        <tr>
                          <td>
                            {member.avatarUrl ? (
                              <Image
                                src={member.avatarUrl}
                                alt={member.name}
                                size="48x48"
                                rounded
                                imgStyle="object-fit: cover;"
                              />
                            ) : (
                              <figure class="image is-48x48">
                                <div
                                  style={`width: 48px; height: 48px; border-radius: 50%; background-color: ${getColorFromInitials(getInitials(member.name))}; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.25rem; font-weight: bold;`}
                                >
                                  {getInitials(member.name)}
                                </div>
                              </figure>
                            )}
                          </td>
                          <td>{member.name}</td>
                          <td>{member.email}</td>
                          <td>
                            <span
                              class={`tag ${member.role === "admin" ? "is-warning" : "is-info"}`}
                            >
                              {member.role === "admin" ? "Admin" : "Member"}
                            </span>
                          </td>
                          <td>
                            {new Date(member.joinedAt).toLocaleDateString()}
                          </td>
                          {member.id !== user.id && (
                            <td>
                              <div class="buttons are-small">
                                {viewAsBlocked && !viewAsBlocked.has(member.id) && (
                                  <form method="POST" action="/view-as" style="display: inline;">
                                    <input type="hidden" name="userId" value={member.id} />
                                    <input type="hidden" name="returnTo" value={`/ensembles/${canonicalId}`} />
                                    <Button type="submit" color="link" size="small">
                                      View as
                                    </Button>
                                  </form>
                                )}
                                {member.role === "member" ? (
                                  <form
                                    method="POST"
                                    action={actions.members.promote}
                                    style="display: inline;"
                                  >
                                    <input
                                      type="hidden"
                                      name="ensembleId"
                                      value={ensemble.id}
                                    />
                                    <input
                                      type="hidden"
                                      name="membershipId"
                                      value={member.membershipId}
                                    />
                                    <Button
                                      type="submit"
                                      color="warning"
                                      size="small"
                                    >
                                      Make Admin
                                    </Button>
                                  </form>
                                ) : (
                                  <form
                                    method="POST"
                                    action={actions.members.demote}
                                    style="display: inline;"
                                  >
                                    <input
                                      type="hidden"
                                      name="ensembleId"
                                      value={ensemble.id}
                                    />
                                    <input
                                      type="hidden"
                                      name="membershipId"
                                      value={member.membershipId}
                                    />
                                    <Button
                                      type="submit"
                                      color="info"
                                      size="small"
                                    >
                                      Remove Admin
                                    </Button>
                                  </form>
                                )}
                                <form
                                  method="POST"
                                  action={actions.members.remove}
                                  style="display: inline;"
                                >
                                  <input
                                    type="hidden"
                                    name="ensembleId"
                                    value={ensemble.id}
                                  />
                                  <input
                                    type="hidden"
                                    name="membershipId"
                                    value={member.membershipId}
                                  />
                                  <Button
                                    type="submit"
                                    color="danger"
                                    size="small"
                                  >
                                    Remove
                                  </Button>
                                </form>
                              </div>
                            </td>
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </Table>
                </div>
              )}
            </>
          ) : (
            <Table>
              <thead>
                <tr>
                  <th style="width: 60px;" />
                  <th>Name</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th>Joined</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {members.map((member) => (
                  <tr>
                    <td>
                      {member.avatarUrl ? (
                        <Image
                          src={member.avatarUrl}
                          alt={member.name}
                          size="48x48"
                          rounded
                          imgStyle="object-fit: cover;"
                        />
                      ) : (
                        <figure class="image is-48x48">
                          <div
                            style={`width: 48px; height: 48px; border-radius: 50%; background-color: ${getColorFromInitials(getInitials(member.name))}; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.25rem; font-weight: bold;`}
                          >
                            {getInitials(member.name)}
                          </div>
                        </figure>
                      )}
                    </td>
                    <td>{member.name}</td>
                    <td>{member.email}</td>
                    <td>
                      <span
                        class={`tag ${member.role === "admin" ? "is-warning" : "is-info"}`}
                      >
                        {member.role === "admin" ? "Admin" : "Member"}
                      </span>
                    </td>
                    <td>{new Date(member.joinedAt).toLocaleDateString()}</td>
                    {member.id !== user.id && (
                      <td>
                        <div class="buttons are-small">
                          {viewAsBlocked && !viewAsBlocked.has(member.id) && (
                            <form method="POST" action="/view-as" style="display: inline;">
                              <input type="hidden" name="userId" value={member.id} />
                              <input type="hidden" name="returnTo" value={`/ensembles/${canonicalId}`} />
                              <Button type="submit" color="link" size="small">
                                View as
                              </Button>
                            </form>
                          )}
                          {member.role === "member" ? (
                            <form
                              method="POST"
                              action={actions.members.promote}
                              style="display: inline;"
                            >
                              <input
                                type="hidden"
                                name="ensembleId"
                                value={ensemble.id}
                              />
                              <input
                                type="hidden"
                                name="membershipId"
                                value={member.membershipId}
                              />
                              <Button
                                type="submit"
                                color="warning"
                                size="small"
                              >
                                Make Admin
                              </Button>
                            </form>
                          ) : (
                            <form
                              method="POST"
                              action={actions.members.demote}
                              style="display: inline;"
                            >
                              <input
                                type="hidden"
                                name="ensembleId"
                                value={ensemble.id}
                              />
                              <input
                                type="hidden"
                                name="membershipId"
                                value={member.membershipId}
                              />
                              <Button type="submit" color="info" size="small">
                                Remove Admin
                              </Button>
                            </form>
                          )}
                          <form
                            method="POST"
                            action={actions.members.remove}
                            style="display: inline;"
                          >
                            <input
                              type="hidden"
                              name="ensembleId"
                              value={ensemble.id}
                            />
                            <input
                              type="hidden"
                              name="membershipId"
                              value={member.membershipId}
                            />
                            <Button type="submit" color="danger" size="small">
                              Remove
                            </Button>
                          </form>
                        </div>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </Table>
          )
        }
      </Box>
    </Container>
  </Section>

  {
    canAddMembers && (
      <Modal id="add-member-modal" title="Add Member">
        <form id="addMemberForm" method="POST" action={actions.members.add}>
          <input type="hidden" name="ensembleId" value={ensemble.id} />
          <TextInput name="email" type="email" label="Email *" required />
          <TextInput
            name="name"
            label="Name"
            help="Needed if they don't have an account yet."
          />
          <Select name="role" label="Role" fullwidth>
            <option value="member" selected>
              Member
            </option>
            <option value="admin">Ensemble admin</option>
          </Select>
          <p class="help">
            New people get an account and an email with a link to set their
            password. People who already have an account get an email saying
            they were added.
          </p>
        </form>
        <div slot="footer">
          <Button type="submit" form="addMemberForm" color="primary">
            <Icon icon="fa-user-plus" />
            <span>Add Member</span>
          </Button>
          <Button type="button" data-modal-close>
            Cancel
          </Button>
        </div>
      </Modal>
    )
  }

  <script is:inline>
    document.addEventListener("astro:page-load", () => {
      document.getElementById("add-member-btn")?.addEventListener("click", () => {
        document.getElementById("add-member-modal")?.classList.add("is-active");
      });
      document
        .getElementById("copy-set-password-url")
        ?.addEventListener("click", (event) => {
          const input = document.getElementById("set-password-url");
          navigator.clipboard.writeText(input.value);
          event.currentTarget.textContent = "Copied";
        });
    });
  </script>
</BaseLayout>
