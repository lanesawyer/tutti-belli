---
import {
  Button,
  Checkbox,
  Icon,
  Modal,
  Notification,
  Table,
  Tag,
  TextInput,
  Title,
} from "astro-bulma";
import EnsemblePageLayout from "@layouts/EnsemblePageLayout.astro";
import { getEnsembleAccess } from "@lib/ensemble";
import {
  getSongsPageData,
  buildSongPartsMap,
  buildSongSeasonsMap,
  buildSongFilesMap,
  formatRuntime,
} from "@lib/songs";
import { getEnsembleUrlId } from "@lib/slug";
import { actions } from "astro:actions";

const user = Astro.locals.user!;
const { id } = Astro.params;

const { ensemble, songs, parts, seasons, songPartsData, seasonSongsData, songFilesData } =
  await getSongsPageData(id!);

if (!ensemble) {
  return new Response("Ensemble not found", { status: 404 });
}

const canonicalId = getEnsembleUrlId(ensemble);
if (id !== canonicalId) {
  return Astro.redirect(
    Astro.url.pathname.replace(`/ensembles/${id}`, `/ensembles/${canonicalId}`),
    301,
  );
}

const access = await getEnsembleAccess(user, ensemble.id);
if (!access) return Astro.redirect("/ensembles");
const { isAdmin } = access;

const addResult = Astro.getActionResult(actions.songs.add);
const editResult = Astro.getActionResult(actions.songs.edit);
const deleteResult = Astro.getActionResult(actions.songs.delete);
const addFileResult = Astro.getActionResult(actions.songs.addFile);
const deleteFileResult = Astro.getActionResult(actions.songs.deleteFile);

if (
  (addResult && !addResult.error) ||
  (editResult && !editResult.error) ||
  (deleteResult && !deleteResult.error) ||
  (addFileResult && !addFileResult.error) ||
  (deleteFileResult && !deleteFileResult.error)
) {
  return Astro.redirect(`/ensembles/${canonicalId}/songs`);
}

const addError = addResult?.error?.message ?? (addResult?.error ? "Failed to add song." : null);
const editError =
  editResult?.error?.message ?? (editResult?.error ? "Failed to update song." : null);
const deleteError =
  deleteResult?.error?.message ?? (deleteResult?.error ? "Failed to delete song." : null);

const ensembleSongIds = new Set(songs.map((s) => s.id));
const songPartsMap = buildSongPartsMap(songPartsData);
const songSeasonsMap = buildSongSeasonsMap(seasonSongsData);
const songFilesMap = buildSongFilesMap(ensembleSongIds, songFilesData);
---

<EnsemblePageLayout
  title={`Songs - ${ensemble.name}`}
  ensembleName={ensemble.name}
  ensembleId={canonicalId}
  pageTitle="Songs"
  pageSubtitle={`Repertoire for ${ensemble.name}`}
  isAdmin={isAdmin}
>
  {isAdmin && (
    <Button slot="action" color="primary" id="add-song-btn">
      <Icon icon="fa-plus" />
      <span>Add Song</span>
    </Button>
  )}

  {songs.length === 0 ? (
    <Notification color="info" light>
      No songs added yet. Click "Add Song" to get started.
    </Notification>
  ) : (
    <Table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Composer</th>
          <th>Arranger</th>
          <th>Runtime</th>
          <th>Parts</th>
          <th>Seasons</th>
          <th style="width: 1%; white-space: nowrap;">Files</th>
        </tr>
      </thead>
      <tbody>
        {songs.map((song) => {
          const songParts = songPartsMap.get(song.id) || [];
          const songSeasons = songSeasonsMap.get(song.id) || [];
          const songFiles = songFilesMap.get(song.id) || [];
          return (
            <tr>
              <td>
                <a href={`/ensembles/${canonicalId}/songs/${song.id}`} class="has-text-weight-bold">
                  {song.name}
                </a>
              </td>
              <td>{song.composer || "-"}</td>
              <td>{song.arranger || "-"}</td>
              <td>{formatRuntime(song.runTime)}</td>
              <td>
                {songParts.length > 0 ? (
                  <div class="tags are-small">
                    {songParts.map((partId: string) => {
                      const part = parts.find((p) => p.id === partId);
                      return part ? <Tag color="info">{part.name}</Tag> : null;
                    })}
                  </div>
                ) : (
                  "-"
                )}
              </td>
              <td>
                {songSeasons.length > 0 ? (
                  <div class="tags are-small">
                    {songSeasons.map((seasonId: string) => {
                      const season = seasons.find((s) => s.id === seasonId);
                      return season ? <Tag color="primary">{season.name}</Tag> : null;
                    })}
                  </div>
                ) : (
                  "-"
                )}
              </td>
              <td>
                <div class="buttons are-small is-flex-wrap-nowrap">
                  <Button
                    class="is-linkspan files-btn"
                    data-song-id={song.id}
                    data-song-name={song.name}
                  >
                    <Icon icon="fa-folder-open" size="small" />
                    {songFiles.length > 0 && <span>{songFiles.length}</span>}
                  </Button>
                  {isAdmin && (
                    <>
                      <Button color="info" class="edit-btn" data-song-id={song.id}>
                        <Icon icon="fa-pencil" size="small" />
                      </Button>
                      <Button color="danger" class="delete-btn" data-song-id={song.id}>
                        <Icon icon="fa-trash" size="small" />
                      </Button>
                    </>
                  )}
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </Table>
  )}

  <Fragment slot="modals">
    <!-- Add Song Modal -->
    <Modal id="addModal" title="Add Song">
      {addError && (
        <Notification color="danger" light dismissible class="mb-4">
          {addError}
        </Notification>
      )}
      <form id="addForm" method="POST" action={actions.songs.add}>
        <input type="hidden" name="ensembleId" value={ensemble.id} />

        <TextInput name="name" label="Song Name *" placeholder="Song name" required />
        <TextInput name="composer" label="Composer" placeholder="Composer name" />
        <TextInput name="arranger" label="Arranger" placeholder="Arranger name" />

        <div class="field">
          <label class="label">Runtime</label>
          <div class="field has-addons">
            <div class="control">
              <TextInput
                name="runTimeMinutes"
                type="number"
                placeholder="Min"
                min="0"
                style="width: 80px;"
                standalone
              />
            </div>
            <div class="control">
              <span class="button is-static">:</span>
            </div>
            <div class="control">
              <TextInput
                name="runTimeSeconds"
                type="number"
                placeholder="Sec"
                min="0"
                max="59"
                style="width: 80px;"
                standalone
              />
            </div>
          </div>
          <p class="help">Leave blank if unknown</p>
        </div>

        {parts.length > 0 && (
          <div class="field">
            <label class="label">Parts</label>
            <div class="control">
              {parts.map((part) => (
                <Checkbox name="parts" value={part.id} label={part.name} class="is-block mb-2" />
              ))}
            </div>
            <p class="help">Select which parts sing this song</p>
          </div>
        )}

        {seasons.length > 0 && (
          <div class="field">
            <label class="label">Seasons</label>
            <div class="control">
              {seasons.map((season) => (
                <Checkbox
                  name="seasons"
                  value={season.id}
                  label={season.name}
                  class="is-block mb-2"
                />
              ))}
            </div>
            <p class="help">Assign to seasons (optional)</p>
          </div>
        )}
      </form>

      <div slot="footer">
        <Button type="submit" form="addForm" color="primary">
          Add Song
        </Button>
        <Button type="button" data-modal-close>
          Cancel
        </Button>
      </div>
    </Modal>

    <!-- Files Modal -->
    <Modal id="filesModal" title="Files">
      <p class="modal-card-title-song mb-3">
        Song: <span id="filesModalSongName" class="has-text-weight-bold"></span>
      </p>

      <div id="filesModalList"></div>

      {isAdmin && (
        <>
          <hr />

          <Title as="h3" size={6}>
            Add Link
          </Title>
          <form id="addFileForm" method="POST" action={actions.songs.addFile}>
            <input type="hidden" name="ensembleId" value={ensemble.id} />
            <input type="hidden" name="songId" id="addFileSongId" />
            <input type="hidden" name="category" value="link" />

            <TextInput
              name="fileName"
              id="fileName"
              label="Display Name *"
              placeholder="e.g. Reference Recording"
              size="small"
              required
            />
            <TextInput
              name="fileUrl"
              id="fileUrl"
              label="URL *"
              type="url"
              placeholder="https://..."
              size="small"
              required
              help="To upload sheet music or a recording, open the song."
            />

            <div class="field">
              <div class="control">
                <Button type="submit" color="primary" size="small">
                  <Icon icon="fa-plus" size="small" />
                  <span>Add Link</span>
                </Button>
              </div>
            </div>
          </form>
        </>
      )}

      <div slot="footer">
        <Button type="button" data-modal-close>
          Close
        </Button>
      </div>
    </Modal>

    <!-- Edit Modal -->
    <Modal id="editModal" title="Edit Song">
      {editError && (
        <Notification color="danger" light dismissible class="mb-4">
          {editError}
        </Notification>
      )}
      <form id="editForm" method="POST" action={actions.songs.edit}>
        <input type="hidden" name="ensembleId" value={ensemble.id} />
        <input type="hidden" name="songId" id="editSongId" />

        <TextInput name="name" id="editName" label="Song Name *" required />
        <TextInput name="composer" id="editComposer" label="Composer" />
        <TextInput name="arranger" id="editArranger" label="Arranger" />

        <div class="field">
          <label class="label">Runtime</label>
          <div class="field has-addons">
            <div class="control">
              <TextInput
                name="runTimeMinutes"
                id="editRunTimeMinutes"
                type="number"
                placeholder="Min"
                min="0"
                style="width: 80px;"
                standalone
              />
            </div>
            <div class="control">
              <span class="button is-static">:</span>
            </div>
            <div class="control">
              <TextInput
                name="runTimeSeconds"
                id="editRunTimeSeconds"
                type="number"
                placeholder="Sec"
                min="0"
                max="59"
                style="width: 80px;"
                standalone
              />
            </div>
          </div>
        </div>

        {parts.length > 0 && (
          <div class="field">
            <label class="label">Parts</label>
            <div class="control" id="editParts">
              {parts.map((part) => (
                <Checkbox name="parts" value={part.id} label={part.name} class="is-block mb-2" />
              ))}
            </div>
          </div>
        )}

        {seasons.length > 0 && (
          <div class="field">
            <label class="label">Seasons</label>
            <div class="control" id="editSeasons">
              {seasons.map((season) => (
                <Checkbox
                  name="seasons"
                  value={season.id}
                  label={season.name}
                  class="is-block mb-2"
                />
              ))}
            </div>
          </div>
        )}
      </form>

      <div slot="footer">
        <Button type="submit" form="editForm" color="primary">
          Save Changes
        </Button>
        <Button type="button" data-modal-close>
          Cancel
        </Button>
      </div>
    </Modal>

    <!-- Delete Confirmation Modal -->
    <Modal id="deleteModal" title="Delete Song">
      {deleteError && (
        <Notification color="danger" light dismissible class="mb-4">
          {deleteError}
        </Notification>
      )}
      <p>Are you sure you want to delete this song? This action cannot be undone.</p>
      <form id="deleteForm" method="POST" action={actions.songs.delete}>
        <input type="hidden" name="ensembleId" value={ensemble.id} />
        <input type="hidden" name="songId" id="deleteSongId" />
      </form>

      <div slot="footer">
        <Button type="submit" form="deleteForm" color="danger">
          Delete
        </Button>
        <Button type="button" data-modal-close>
          Cancel
        </Button>
      </div>
    </Modal>

    <script
      is:inline
      id="songs-data"
      data-songs={JSON.stringify(songs)}
      data-song-parts={JSON.stringify(Array.from(songPartsMap.entries()))}
      data-song-seasons={JSON.stringify(Array.from(songSeasonsMap.entries()))}
      data-song-files={JSON.stringify(Array.from(songFilesMap.entries()))}
      data-is-admin={isAdmin ? "true" : "false"}
      data-ensemble-id={ensemble.id}
      data-open-modal={
        addError ? "addModal" : editError ? "editModal" : deleteError ? "deleteModal" : ""
      }
    ></script>

    <script>
      type SongData = {
        id: string;
        name: string;
        composer: string | null;
        arranger: string | null;
        runTime: number | null;
      };
      type SongFileData = { id: string; name: string; category: string };

      function initSongsPage() {
        const dataScript = document.getElementById("songs-data");
        if (!dataScript) return;
        const ensembleId = dataScript.dataset.ensembleId || "";
        const songsData: SongData[] = JSON.parse(dataScript.dataset.songs || "[]");
        const songPartsMapJS = new Map<string, string[]>(
          JSON.parse(dataScript.dataset.songParts || "[]"),
        );
        const songSeasonsMapJS = new Map<string, string[]>(
          JSON.parse(dataScript.dataset.songSeasons || "[]"),
        );
        const songFilesMapJS = new Map<string, SongFileData[]>(
          JSON.parse(dataScript.dataset.songFiles || "[]"),
        );
        const isAdmin = dataScript.dataset.isAdmin === "true";

        function categoryLabel(cat: string) {
          if (cat === "sheet_music") return "Sheet Music";
          if (cat === "rehearsal_track") return "Rehearsal Track";
          return "Other";
        }

        function categoryTagClass(cat: string) {
          if (cat === "sheet_music") return "is-success";
          if (cat === "rehearsal_track") return "is-warning";
          return "is-light";
        }

        // ── Auto-open modal on error (after form submission failure) ──────────────
        const openModal = dataScript.dataset.openModal;
        if (openModal) {
          document.getElementById(openModal)?.classList.add("is-active");
        }

        // ── Add modal ─────────────────────────────────────────────────────────────
        document.getElementById("add-song-btn")?.addEventListener("click", () => {
          document.getElementById("addModal")?.classList.add("is-active");
        });

        // ── Files modal ──────────────────────────────────────────────────────────

        const filesModal = document.getElementById("filesModal")!;

        function renderFilesList(songId: string) {
          const files = songFilesMapJS.get(songId) || [];
          const container = document.getElementById("filesModalList")!;
          if (files.length === 0) {
            const empty = document.createElement("p");
            empty.className = "has-text-grey";
            empty.textContent = "No files yet.";
            container.replaceChildren(empty);
            return;
          }
          container.replaceChildren(...files.map(fileRow));
        }

        function hiddenInput(name: string, value: string) {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = name;
          input.value = value;
          return input;
        }

        function fileRow(f: SongFileData) {
          const row = document.createElement("div");
          row.className = "is-flex is-align-items-center mb-2";
          row.style.gap = "0.5rem";

          const tag = document.createElement("span");
          tag.className = `tag ${categoryTagClass(f.category)} is-small`;
          tag.style.flexShrink = "0";
          tag.textContent = categoryLabel(f.category);

          const link = document.createElement("a");
          link.href = `/files/${encodeURIComponent(f.id)}`;
          link.className = "has-text-weight-medium song-file-name";
          link.style.cssText =
            "flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;";
          link.textContent = f.name;

          row.append(tag, link);

          if (isAdmin) {
            const form = document.createElement("form");
            form.method = "POST";
            form.action = "?_action=songs.deleteFile";
            form.style.flexShrink = "0";
            form.dataset.confirm = "Delete this file?";

            const button = document.createElement("button");
            button.type = "submit";
            button.className = "button is-danger is-small";
            const icon = document.createElement("span");
            icon.className = "icon is-small";
            const glyph = document.createElement("i");
            glyph.className = "fas fa-trash";
            icon.append(glyph);
            button.append(icon);

            form.append(hiddenInput("ensembleId", ensembleId), hiddenInput("fileId", f.id), button);
            row.append(form);
          }

          return row;
        }

        document.querySelectorAll(".files-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const songId = btn.getAttribute("data-song-id") ?? "";
            const songName = btn.getAttribute("data-song-name");
            document.getElementById("filesModalSongName")!.textContent = songName;
            (document.getElementById("addFileSongId") as HTMLInputElement).value = songId;
            (document.getElementById("fileName") as HTMLInputElement).value = "";
            (document.getElementById("fileUrl") as HTMLInputElement).value = "";
            renderFilesList(songId);
            filesModal.classList.add("is-active");
          });
        });

        // ── Edit modal ───────────────────────────────────────────────────────────

        const editModal = document.getElementById("editModal")!;

        document.querySelectorAll(".edit-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const songId = btn.getAttribute("data-song-id") ?? "";
            const song = songsData.find((s) => s.id === songId);
            if (!song) return;

            (document.getElementById("editSongId") as HTMLInputElement).value = song.id;
            (document.getElementById("editName") as HTMLInputElement).value = song.name;
            (document.getElementById("editComposer") as HTMLInputElement).value =
              song.composer || "";
            (document.getElementById("editArranger") as HTMLInputElement).value =
              song.arranger || "";

            if (song.runTime) {
              (document.getElementById("editRunTimeMinutes") as HTMLInputElement).value = String(
                Math.floor(song.runTime / 60),
              );
              (document.getElementById("editRunTimeSeconds") as HTMLInputElement).value = String(
                song.runTime % 60,
              );
            } else {
              (document.getElementById("editRunTimeMinutes") as HTMLInputElement).value = "";
              (document.getElementById("editRunTimeSeconds") as HTMLInputElement).value = "";
            }

            const songParts = songPartsMapJS.get(songId) || [];
            document
              .querySelectorAll<HTMLInputElement>('#editParts input[type="checkbox"]')
              .forEach((cb) => {
                cb.checked = songParts.includes(cb.value);
              });

            const songSeasons = songSeasonsMapJS.get(songId) || [];
            document
              .querySelectorAll<HTMLInputElement>('#editSeasons input[type="checkbox"]')
              .forEach((cb) => {
                cb.checked = songSeasons.includes(cb.value);
              });

            editModal.classList.add("is-active");
          });
        });

        // ── Delete modal ─────────────────────────────────────────────────────────

        const deleteModal = document.getElementById("deleteModal")!;

        document.querySelectorAll(".delete-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            (document.getElementById("deleteSongId") as HTMLInputElement).value =
              btn.getAttribute("data-song-id") ?? "";
            deleteModal.classList.add("is-active");
          });
        });
      }

      document.addEventListener("astro:page-load", initSongsPage);
    </script>
  </Fragment>
</EnsemblePageLayout>
