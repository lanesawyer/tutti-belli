---
import {
  Button,
  Card,
  Column,
  Columns,
  Icon,
  Notification,
  Subtitle,
  Tag,
  Title,
} from "astro-bulma";
import PageLayout from "@layouts/PageLayout.astro";
import { getUserEnsembles } from "@lib/ensemble";
import { getEnsembleUrlId } from "@lib/slug";

const user = Astro.locals.user!;

const userEnsembles = await getUserEnsembles(user.id);
---

<PageLayout title="My Ensembles" pageTitle="My Ensembles">
  <div slot="action" class="buttons">
    <Button href="/invite/join" color="light">
      <Icon icon="fa-ticket" />
      <span>Join with Invite Code</span>
    </Button>
    <Button href="/ensembles/new" color="primary">
      <Icon icon="fa-plus" />
      <span>Create Ensemble</span>
    </Button>
  </div>

  {
    userEnsembles.length > 0 ? (
      <Columns multiline>
        {userEnsembles.map((ensemble) => (
          <Column size={4}>
            <Card>
              <Title as="p" size={4}>
                {ensemble.name}
              </Title>
              {ensemble.description && (
                <Subtitle as="p" size={6}>
                  {ensemble.description}
                </Subtitle>
              )}
              <div class="tags mt-2">
                <Tag color={ensemble.role === "admin" ? "warning" : "info"}>
                  {ensemble.role === "admin" ? "Ensemble Admin" : "Member"}
                </Tag>
              </div>
              <a
                slot="footer"
                href={`/ensembles/${getEnsembleUrlId(ensemble)}`}
                class="card-footer-item"
              >
                View Details
              </a>
            </Card>
          </Column>
        ))}
      </Columns>
    ) : (
      <Notification color="info" light>
        <p>
          You haven't joined any ensembles yet. Ask your ensemble admin for an
          invite code!
        </p>
      </Notification>
    )
  }
</PageLayout>
