---
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  Box,
  Button,
  Column,
  Columns,
  Container,
  Content,
  Hero,
  Icon,
  Media,
  Section,
  Subtitle,
  Title,
} from "astro-bulma";
import { APP_NAME, APP_SLOGAN } from "@lib/config";

const user = Astro.locals.user;

const features = [
  {
    icon: "fa-users",
    title: "Member Management",
    text: "Invite members via unique codes, assign roles, and manage membership status. Track who's active across seasons.",
  },
  {
    icon: "fa-calendar-check",
    title: "Rehearsal Scheduling",
    text: "Schedule rehearsals and events, track attendance for each session, and keep your ensemble on track.",
  },
  {
    icon: "fa-music",
    title: "Repertoire Library",
    text: "Build a library of songs and assign them to voice parts. Organize repertoire by season so your music is always at hand.",
  },
  {
    icon: "fa-calendar-alt",
    title: "Seasons",
    text: "Organize your ensemble's activities into seasons. Manage seasonal memberships and tie repertoire to each season.",
  },
  {
    icon: "fa-bullhorn",
    title: "Announcements",
    text: "Post announcements to keep all your members informed about upcoming events, changes, and important news.",
  },
  {
    icon: "fa-users-cog",
    title: "Groups & Sections",
    text: "Create custom sub-groups within your ensemble — sections, committees, or any arbitrary grouping you need.",
  },
  {
    icon: "fa-list",
    title: "Voice Parts",
    text: "Define custom voice parts or instrument sections for your ensemble and assign members and songs accordingly.",
  },
  {
    icon: "fa-moon",
    title: "Dark Mode",
    text: "A polished interface with full dark mode support — easy on the eyes during late-night rehearsal prep.",
  },
];
---

<BaseLayout title="Home">
  <Hero color="primary" size="medium">
    <Title as="p">
      Welcome to {APP_NAME}
    </Title>
    <Subtitle as="p">
      {APP_SLOGAN}
    </Subtitle>
    {
      !user && (
        <div class="buttons mt-4">
          <Button href="/register" color="light" size="large">
            <Icon icon="fa-user-plus" />
            <span>Sign Up Free</span>
          </Button>
          <Button href="/login" color="primary" size="large" style="outlined">
            <Icon icon="fa-sign-in-alt" />
            <span>Log In</span>
          </Button>
        </div>
      )
    }
    {
      user && (
        <div class="buttons mt-4">
          <Button href="/ensembles" color="light" size="large">
            <Icon icon="fa-users" />
            <span>My Ensembles</span>
          </Button>
        </div>
      )
    }
  </Hero>

  <Section>
    <Container>
      <Title as="h2" size={3} class="has-text-centered mb-6">
        Everything your ensemble needs
      </Title>
      <Columns multiline>
        {
          features.map((feature) => (
            <Column size="half">
              <Box>
                <Media>
                  <Icon
                    slot="left"
                    icon={`fa-2x ${feature.icon}`}
                    size="large"
                    color="primary"
                  />
                  <Title as="h3" size={5}>
                    {feature.title}
                  </Title>
                  <p>{feature.text}</p>
                </Media>
              </Box>
            </Column>
          ))
        }
      </Columns>
    </Container>
  </Section>

  <Section>
    <Container>
      <Columns vcentered>
        <Column narrow class="has-text-centered mr-5">
          <span class="icon has-text-primary" style="font-size: 4rem;">
            <i class="fab fa-github"></i>
          </span>
        </Column>
        <Column>
          <Title as="h2" size={3}>Free &amp; open source</Title>
          <Subtitle as="p" size={5}>
            Tutti Belli is open source software. You're welcome to run your
            ensemble on the hosted site — or self-host it on your own
            infrastructure if you prefer to keep full control.
          </Subtitle>
          <Button
            href="https://github.com/lanesawyer/tutti-belli"
            target="_blank"
            rel="noopener noreferrer"
            class="is-dark"
          >
            <Icon icon="fa-github" variant="fab" />
            <span>View on GitHub</span>
          </Button>
        </Column>
      </Columns>
    </Container>
  </Section>

  <Section>
    <Container>
      <Columns vcentered>
        <Column narrow class="has-text-centered mr-5">
          <span class="icon has-text-primary" style="font-size: 4rem;">
            <i class="fas fa-envelope"></i>
          </span>
        </Column>
        <Column>
          <Title as="h2" size={3}>Get in touch</Title>
          <Subtitle as="p" size={5}>
            Have a feature request, found a bug, or want to get involved? Open
            an issue on GitHub.
          </Subtitle>
          <div class="buttons">
            <Button
              href="https://github.com/lanesawyer/tutti-belli/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="is-dark"
            >
              <Icon icon="fa-github" variant="fab" />
              <span>Open an Issue</span>
            </Button>
          </div>
        </Column>
      </Columns>
    </Container>
  </Section>

  {
    !user && (
      <Section>
        <Content class="has-text-centered">
          <Title as="h2" size={3}>
            Ready to get organized?
          </Title>
          <Subtitle as="p" size={5}>
            Create an account and start managing your ensemble today.
          </Subtitle>
          <div class="buttons is-centered">
            <Button href="/register" color="primary" size="large">
              <Icon icon="fa-user-plus" />
              <span>Sign Up Free</span>
            </Button>
            <Button href="/login" color="light" size="large">
              <Icon icon="fa-sign-in-alt" />
              <span>Log In</span>
            </Button>
          </div>
        </Content>
      </Section>
    )
  }

  {
    user && (
      <Section>
        <Content class="has-text-centered">
          <Title as="h2" size={3}>
            Welcome back, {user.name}!
          </Title>
          <div class="buttons is-centered">
            <Button href="/ensembles" color="primary" size="large">
              <Icon icon="fa-users" />
              <span>View My Ensembles</span>
            </Button>
            {user.role === "admin" && (
              <Button href="/admin" color="info" size="large">
                <Icon icon="fa-cog" />
                <span>Admin Panel</span>
              </Button>
            )}
          </div>
        </Content>
      </Section>
    )
  }
</BaseLayout>
