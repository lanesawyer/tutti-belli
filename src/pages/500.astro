---
import { Block, Button, Icon, Subtitle, Title } from "astro-bulma";
import SingleColumnLayout from "@layouts/SingleColumnLayout.astro";
---

<SingleColumnLayout title="500 – Something Went Wrong">
  <div class="has-text-centered" style="padding: 4rem 1rem;">
    <div style="font-size: 6rem; line-height: 1; margin-bottom: 1rem;">
      &#x1D10A;
    </div>
    <Title size={1}>500</Title>
    <Subtitle size={3}>The ensemble lost the beat</Subtitle>
    <Block style="max-width: 480px; margin: 0 auto 2rem;">
      Something backstage went wrong — a wrong note, a missed cue, maybe the
      oboist came in early again. Our stagehands have been notified. Please try
      again in a moment.
    </Block>
    <Button href="/" color="warning">
      <Icon icon="fa-rotate-right" />
      <span>Try from the Top</span>
    </Button>
  </div>
</SingleColumnLayout>
