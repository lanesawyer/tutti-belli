---
import { Block, Button, Icon, Subtitle, Title } from "astro-bulma";
import SingleColumnLayout from "@layouts/SingleColumnLayout.astro";
---

<SingleColumnLayout title="404 – Page Not Found">
  <div class="has-text-centered" style="padding: 4rem 1rem;">
    <div style="font-size: 6rem; line-height: 1; margin-bottom: 1rem;">𝄩</div>
    <Title size={1}>404</Title>
    <Subtitle size={3}>That note doesn't exist</Subtitle>
    <Block style="max-width: 480px; margin: 0 auto 2rem;">
      We searched the whole score and couldn't find this page. It may have been
      cut from a previous arrangement, or the conductor never wrote it down.
    </Block>
    <Button href="/" color="primary">
      <Icon icon="fa-home" />
      <span>Back to the Podium</span>
    </Button>
  </div>
</SingleColumnLayout>
