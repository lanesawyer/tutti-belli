{
  "name": "tutti-belli",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node db/dev-setup.ts && DATABASE_URL=file:.astro/content.db astro dev",
    "dev:remote": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint . --deny-warnings",
    "fmt": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.ts",
    "fly:deploy": "./deploy.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/node": "11.1.11",
    "@aws-sdk/client-s3": "3.1164.0",
    "@libsql/client": "0.18.0",
    "astro": "7.4.7",
    "astro-bulma": "0.6.0",
    "bcryptjs": "3.0.3",
    "bulma": "1.0.4",
    "drizzle-orm": "0.45.4",
    "jsonwebtoken": "9.0.3",
    "qrcode": "1.5.4",
    "resend": "6.37.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@playwright/test": "1.65.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-istanbul": "4.1.10",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
