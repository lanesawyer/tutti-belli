{
  "name": "tutti-belli",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node db/dev-setup.ts && DATABASE_URL=file:.astro/content.db astro dev",
    "dev:remote": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint src/lib db --deny-warnings",
    "fmt": "oxlint src/lib db --fix && prettier --write \"src/**/*.astro\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.ts",
    "fly:deploy": "./deploy.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/node": "10.1.0",
    "@aws-sdk/client-s3": "3.1045.0",
    "@libsql/client": "0.17.3",
    "astro": "6.3.1",
    "astro-bulma": "0.0.1",
    "bcryptjs": "3.0.3",
    "bulma": "1.0.4",
    "drizzle-orm": "0.45.2",
    "jsonwebtoken": "9.0.3",
    "qrcode": "1.5.4",
    "resend": "6.12.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-istanbul": "4.1.6",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.64.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.5.1"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.5.1"
  }
}
